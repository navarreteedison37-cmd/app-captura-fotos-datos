{
  "expo": {
    "name": "App Captura Fotos",
    "slug": "app-captura-fotos",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.captura.fotos"
    },
    "android": {
      "versionCode": 1,
      "package": "com.captura.fotos",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
      ],
      "buildNumber": "1"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera"
        }
      ]
    ],
    "scheme": "myapp",
    "orientation": "portrait"
  }
}
